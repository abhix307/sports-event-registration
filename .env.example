# Copy this file to .env for local use. Never commit .env.
SECRET_KEY=replace-this-with-a-long-random-value
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Optional: use this instead of ADMIN_PASSWORD with a Werkzeug password hash.
# Generate one with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
# ADMIN_PASSWORD_HASH=
# Controlled Arena classroom demo only: uncomment to expose admin actions without login.
# Demo mode also disables CSRF checks; never use on a public or shared deployment.
# DEMO_MODE=false
# Optional cross-site cookie settings if testing authenticated login in an embedded preview:
# SESSION_COOKIE_SAMESITE=None
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_PARTITIONED=true
# WTF_CSRF_SSL_STRICT=false
